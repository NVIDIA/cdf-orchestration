# Copy to secrets.env and fill in values, then run:
#   make setup

NGC_API_KEY=
HF_TOKEN=

# Optional. Required to run OSMO DAGs (Airflow variables osmo_token, osmo_url and osmo_pool).
OSMO_TOKEN=
OSMO_URL=
OSMO_POOL=
# Optional. Pre-populated Hugging Face cache directory mounted on your OSMO pool.
# When empty, OSMO video augmentation downloads models with HF_TOKEN on each run.
OSMO_HF_CACHE_SEED_DIR=

# Optional. SMT AnomalyGen uses VLM_API_KEY when set; otherwise NGC_API_KEY.
VLM_API_KEY=
LLM_API_KEY=

AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
