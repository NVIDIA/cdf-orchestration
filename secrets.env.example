# Copy to secrets.env and fill in values, then run:
#   make setup

NGC_API_KEY=
HF_TOKEN=

# Optional. Required to run OSMO DAGs (Airflow variable osmo_token).
OSMO_TOKEN=

# Optional. SMT AnomalyGen uses VLM_API_KEY when set; otherwise NGC_API_KEY.
VLM_API_KEY=
LLM_API_KEY=

AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
